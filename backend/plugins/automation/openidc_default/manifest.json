{
  "plugin_id": "openidc_default",
  "name": "OpenIDCS Automation (Built-in)",
  "version": "0.2.0",
  "description": "Built-in OpenIDCS-Client automation plugin (catalog + lifecycle + port_mapping + firewall + snapshot + backup + nic/disk/iso/proxy/boot/pci/usb).",
  "binaries": {
    "windows_amd64": "bin/windows_amd64/plugin.exe",
    "linux_amd64": "bin/linux_amd64/plugin",
    "darwin_amd64": "bin/darwin_amd64/plugin",
    "darwin_arm64": "bin/darwin_arm64/plugin"
  },
  "capabilities": {
    "automation": {
      "features": [
        "catalog_sync",
        "lifecycle",
        "port_mapping",
        "backup",
        "snapshot",
        "firewall",
        "nic",
        "disk",
        "iso",
        "reverse_proxy",
        "boot_order",
        "pci",
        "usb",
        "panel_login",
        "vnc",
        "reinstall",
        "reset_password",
        "resize",
        "refund"
      ]
    }
  }
}
